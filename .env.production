# Build-time configuration for a PUBLIC deployment.
#
# Everything here is NEXT_PUBLIC_*, which Next inlines into the client bundle
# at build time -- so these are public facts by construction, not secrets.
# They are committed deliberately: the Sepolia deployment is already recorded
# in cairo/address.md, and a build that only works with someone's private
# .env.local is a build nobody else can reproduce.
#
# .env.local still wins over this file locally, so a devnet session is
# unaffected by anything here.

# PokerGame on Starknet Sepolia, 2026-09-08 (stacks, all-in, side pots,
# scaled blind ladder). NOTE: scripts/deploy_local.sh rewrites .env.LOCAL only,
# so this file has to be updated by hand after a redeploy -- miss it and the
# hosted build keeps pointing at the previous contract.
# See cairo/address.md for the whole address set and what it cost.
NEXT_PUBLIC_POKERGAME_SEPOLIA=0x0042d80afb94a3ec7984a97e1b9790593b2eb8aed77f96c717ebe236434bd75d

# Cartridge rather than a default public endpoint: this page polls hard during
# a showdown, and drpc rate-limited a two-tab UI (14 of 40 rapid reads
# refused) where Cartridge answered 180 concurrent reads without complaint.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# No share relay on this deployment.
#
# "0" disables the relay and falls back to BroadcastChannel, which reaches
# only other tabs of the SAME browser. That is a real limit, stated plainly:
# two different people cannot complete a hand here, because a hole card needs
# a decryption share from every seat and there is nothing to carry it between
# them. One person driving two tabs works fully.
#
# The alternative is worse, not better: the default is http://127.0.0.1:3100,
# and an HTTPS page cannot call localhost -- the browser blocks it as mixed
# content, so shares fail with a console error instead of a clear fallback.
#
# To enable two-player: stand up scripts/relay.mjs on a public HTTPS origin
# and set this to its URL. It is trusted with nothing (shares are sealed to
# the recipient's registered key and carry a DLEQ), so it can be hosted by
# anyone, including a player.
NEXT_PUBLIC_RELAY_URL=0
