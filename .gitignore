# cairo build artifacts
/cairo/target/

# Next.js 16 auto-generates these on every `next dev` run (see
# node_modules/next/dist/server/lib/generate-agent-files.js) — not
# hand-authored project docs, so don't track the regenerated copies.
# This project's real Claude Code memory file is CLAUDE.local.md (untracked
# by default anyway) plus whatever's in .claude/ — see HANDOFF.md instead
# for cross-session continuity notes.
/CLAUDE.md
/AGENTS.md

# Cairo/Noir build output outside the root and cairo/ (added when
# cairo-verifier/ and circuits/ appeared -- the bare /target rule does not
# reach them, and they are ~70MB of regenerable artifacts).
cairo-verifier/target/
circuits/*/target/
circuits/*/*/target/
**/.snfoundry_cache/

# starknet-skills ships ~2.4MB of datasets, eval fixtures and a website that
# nothing in this repo's audit process reads. The skill modules and the
# preflight script ARE tracked -- HANDOFF §2 explains why: the untracked copy
# of this bundle did not survive the last machine move, and §5's procedure
# cannot run without it.
.agents/skills/starknet-skills/datasets/
.agents/skills/starknet-skills/evals/
.agents/skills/starknet-skills/website/

# esbuild scratch for scripts/check_client_crypto.mjs
node_modules/.cache/
